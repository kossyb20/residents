{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "residents",
  "compatibility_date": "2026-11-01",
  // Static site: serve the Vite build; unknown paths (e.g. /trading-floor) fall back to index.html.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
